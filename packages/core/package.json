{
  "name": "gpu-doodle",
  "version": "0.0.0",
  "description": "A compact neural doodle classifier for the browser",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "echo 'build: stage 4' && exit 0",
    "build:release": "echo 'size gate: stage 7' && exit 0",
    "test": "vitest run --passWithNoTests",
    "test:browser": "echo 'browser parity: stage 5' && exit 0",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@webgpu/types": "0.1.72",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "keywords": [
    "doodle",
    "sketch",
    "quickdraw",
    "webgpu"
  ],
  "license": "MIT"
}
